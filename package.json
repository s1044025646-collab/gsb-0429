{
  "name": "ising-replay-backend",
  "version": "1.0.0",
  "description": "二维 Ising 显式提议序列回放后端",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "ising": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "node --experimental-strip-types src/server.ts",
    "test": "npm run build && node dist/test/run-tests.js",
    "demo": "npm run build && node dist/demo.js",
    "cli": "npm run build && node dist/cli.js"
  },
  "keywords": [
    "ising",
    "metropolis",
    "typescript",
    "sqlite"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.0.0",
    "typescript": "^5.8.0"
  }
}
